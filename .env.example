# Gold Procurement App – Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env for local dev (never commit .env to git)
# Set these as Railway environment variables in production.

# Login credentials
APP_USERNAME=admin
APP_PASSWORD=titan@123

# Flask session secret key – CHANGE THIS to a long random string in production
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
